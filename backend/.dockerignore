# Backend build context is `backend/` — root .dockerignore does NOT apply.
# Keep local secrets out of the image so they cannot shadow Cloud Run env.
.env
.env.local
.env.development
.env.production
.env.staging
.env.*
!.env.example

__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/
.mypy_cache/
*.md
tests/
