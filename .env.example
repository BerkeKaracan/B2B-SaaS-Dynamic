# --- NEXT.JS FRONTEND ENVIRONMENT VARIABLES ---

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_secret_key"

# Canonical public site URL (sitemap, robots, Open Graph absolute links)
# NEXT_PUBLIC_SITE_URL="https://www.yourdomain.com"

# Browser → API base URL (use https://api.yourdomain.com in real production)
# NEXT_PUBLIC_API_URL="http://localhost:8000"

# Canvas LIVE WebSocket (browser). Prod: set to Cloud Run / API host with wss://
# If unset, derived from NEXT_PUBLIC_API_URL (https→wss). Required on Vercel when
# API is on a different host than the frontend — otherwise LIVE will not connect.
# NEXT_PUBLIC_WS_URL="wss://api.yourdomain.com"
# Optional CSP extras (space/comma-separated) baked at Next build time:
# CSP_CONNECT_WS_ORIGINS="wss://api.yourdomain.com wss://xxx.run.app"

# Server-only: FastAPI origin for middleware / BFF (Docker: http://backend:8000)
# INTERNAL_API_URL="http://127.0.0.1:8000"

# Shared with backend INTERNAL_API_SECRET (middleware by-slug + never expose to browser)
INTERNAL_API_SECRET="change-me-to-a-long-random-string"

# Same JWT secret as backend SUPABASE_JWT_SECRET (middleware local verify; server-only)
# SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Optional: show demo tier switch buttons in billing UI (dev only; backend also gates)
# NEXT_PUBLIC_ALLOW_DEMO_TIER_SWITCH="true"

# CSP: Vercel builds strip ws://localhost automatically (VERCEL=1).
# Force-strict locally: CSP_STRICT=true. Never enable localhost WS on Vercel.
# CSP_STRICT=true

# Resend
RESEND_API_KEY="re_your_resend_api_key"

#Sentry
SENTRY_AUTH_TOKEN="your_sentry_vertification_key"

# Feature Flag Delivery API (server-only — used by /api/features/evaluate proxy)
# FEATURE_FLAGS_API_KEY = Pulse *project delivery* key (not platform admin key).
# Pulse OK → source of truth. Pulse down → local advanced|pro fallback for ai.canvas_generator.
# collab.canvas_sync stays OFF unless Pulse explicitly enables it (Realtime kill-switch).
# Never prefix with NEXT_PUBLIC_ (must not reach the browser).
# FEATURE_FLAGS_URL="http://127.0.0.1:8002"
# Docker Compose SaaS -> Pulse on host: FEATURE_FLAGS_URL=http://host.docker.internal:8002
# FEATURE_FLAGS_API_KEY="pf_..."

# --- Playwright E2E ---
# One command provisions users, projects, and writes `.env.e2e` automatically:
#   npm run test:e2e:setup
# Then (or chained): npm run test:e2e
# Requires backend/.env with Supabase service role + app at E2E_BASE_URL (default http://localhost:3000).
# Optional overrides:
# E2E_BASE_URL="http://localhost:3000"
# E2E_SEED_PASSWORD="E2eLocalPass123!"
# E2E_PRODUCTION_URL="https://your-real-deploy.vercel.app"

